# ==============================================================
# CUSTODY VAULT — Environment Variables Template
# Copy this file to .env for local development only.
# In PRODUCTION, all secrets are read from Azure Key Vault.
# NEVER commit .env to source control.
# ==============================================================

# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- Database (MS SQL Server) ----
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=custody_vault
DB_USER=sa
DB_PASSWORD=YourStrong@Password1
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ---- Azure Key Vault ----
# In production: use Managed Identity (no client secret needed)
# In development: use a service principal
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret-for-dev-only

# Secret name in AKV where the master seed is stored
MASTER_SEED_SECRET_NAME=custody-vault-master-seed

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=custody.events
RABBITMQ_WEBHOOK_QUEUE=custody.webhooks

# ---- HMAC Auth (shared secret for API callers) ----
# In production: read from AKV
HMAC_SECRET=dev-only-secret-replace-in-production-min-64-chars-use-random-value

# ---- Webhook delivery ----
WEBHOOK_AFRICACRYPTO_URL=http://localhost:5000/api/custody/webhook
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000

# ---- Chain RPC (Alchemy — primary) ----
ALCHEMY_ETH_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_BSC_RPC=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ---- Chain RPC (QuickNode — failover) ----
QUICKNODE_ETH_RPC=https://your-endpoint.quiknode.pro/YOUR_KEY/
QUICKNODE_BSC_RPC=https://your-endpoint.bsc.quiknode.pro/YOUR_KEY/
QUICKNODE_POLYGON_RPC=https://your-endpoint.polygon.quiknode.pro/YOUR_KEY/

# ---- Bitcoin ----
BITCOIN_RPC_URL=https://btc.getblock.io/YOUR_KEY/mainnet/
LITECOIN_RPC_URL=https://ltc.getblock.io/YOUR_KEY/mainnet/

# ---- Tron ----
TRON_RPC_URL=https://api.trongrid.io
TRON_API_KEY=your-trongrid-api-key

# ---- Solana ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- XRP ----
XRP_WS_URL=wss://xrplcluster.com

# ---- Sweep thresholds (USD equivalent) ----
SWEEP_THRESHOLD_USD=50

# ---- Gas station low balance alerts (native token) ----
GAS_ALERT_THRESHOLD_ETH=0.05
GAS_ALERT_THRESHOLD_BNB=0.1
GAS_ALERT_THRESHOLD_TRX=100
GAS_ALERT_THRESHOLD_SOL=0.5
GAS_ALERT_THRESHOLD_POL=5

# ---- Withdrawal limits ----
WITHDRAWAL_ALERT_THRESHOLD_USD=10000

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---- Reconciliation schedule (cron) ----
RECONCILIATION_CRON=0 */6 * * *
