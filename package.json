{
  "name": "custody-vault",
  "version": "1.0.0",
  "description": "Self-hosted institutional-grade cryptocurrency custody system for AfricaCrypto",
  "main": "dist/server.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "lint": "eslint src scripts tests --ext .ts",
    "lint:fix": "eslint src scripts tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:coverage": "jest --coverage",
    "test:client": "ts-node scripts/test-client.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node scripts/migrate.ts",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "@solana/web3.js": "^1.95.3",
    "amqplib": "^0.10.4",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.6",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "ecpair": "^2.1.0",
    "ethers": "^6.13.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "mssql": "^11.0.1",
    "node-cron": "^3.0.3",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^5.3.2",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "xrpl": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^9.0.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}
